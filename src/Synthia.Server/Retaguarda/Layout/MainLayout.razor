@inherits LayoutComponentBase
@inject StoreProfileService Store

<div class="shell">
    <aside class="side">
        <a class="brand" href="/retaguarda"><img src="retaguarda/marca/logo?v=@profile?.LogoHash" alt="@profile?.TradeName" /></a>
        <nav>
            <NavLink href="/retaguarda" Match="NavLinkMatch.All">Painel</NavLink>
            <AuthorizeView Roles="@BackofficeRoles.CatalogEditors">
                <NavLink href="/retaguarda/produtos">Produtos</NavLink>
            </AuthorizeView>
            <NavLink href="/retaguarda/entradas">Entradas</NavLink>
            <NavLink href="/retaguarda/notas">Notas (XML)</NavLink>
            <NavLink href="/retaguarda/estoque">Estoque</NavLink>
            <NavLink href="/retaguarda/inventarios">Inventário</NavLink>
            <NavLink href="/retaguarda/ajustes">Perdas e ajustes</NavLink>
            <AuthorizeView Roles="@BackofficeRoles.CatalogEditors">
                <NavLink href="/retaguarda/nfce">NFC-e</NavLink>
                <NavLink href="/retaguarda/relatorios">Vendas</NavLink>
                <NavLink href="/retaguarda/fechamentos">Fechamentos</NavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@BackofficeRoles.Admin">
                <NavLink href="/retaguarda/usuarios">Usuários</NavLink>
                <NavLink href="/retaguarda/loja">Loja</NavLink>
            </AuthorizeView>
        </nav>
        <div class="side-foot">
            <AuthorizeView>
                <div class="who">@context.User.FindFirst(ClaimTypes.GivenName)?.Value</div>
                <small class="role">@BackofficeRoles.Label(context.User.FindFirst(ClaimTypes.Role)?.Value ?? "")</small>
            </AuthorizeView>
            <form method="post" action="/retaguarda/logout">
                <AntiforgeryToken />
                <button type="submit" class="link">Sair</button>
            </form>
            <a href="/retaguarda/minha-senha" class="link">Trocar senha</a>
            <a href="/docs/" class="link">Documentação</a>
        </div>
    </aside>
    <main class="content">
        @Body
    </main>
</div>

@code {
    private Synthia.Contracts.Sync.StoreProfile? profile;

    protected override async Task OnInitializedAsync() => profile = await Store.GetAsync();
}
