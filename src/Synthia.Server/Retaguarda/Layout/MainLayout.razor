@inherits LayoutComponentBase

<div class="shell">
    <aside class="side">
        <a class="brand" href="/retaguarda"><img src="retaguarda/logo-xandao.png" alt="Xandão Supermercados" /></a>
        <nav>
            <NavLink href="/retaguarda" Match="NavLinkMatch.All">Painel</NavLink>
            <NavLink href="/retaguarda/produtos">Produtos</NavLink>
            <NavLink href="/retaguarda/entradas">Entradas</NavLink>
            <NavLink href="/retaguarda/estoque">Estoque</NavLink>
            <NavLink href="/retaguarda/inventarios">Inventário</NavLink>
            <NavLink href="/retaguarda/notas">Notas (XML)</NavLink>
        </nav>
        <div class="side-foot">
            <AuthorizeView>
                <div class="who">@context.User.FindFirst(ClaimTypes.GivenName)?.Value</div>
            </AuthorizeView>
            <form method="post" action="/retaguarda/logout">
                <AntiforgeryToken />
                <button type="submit" class="link">Sair</button>
            </form>
            <a href="/docs/" class="link">Documentação</a>
        </div>
    </aside>
    <main class="content">
        @Body
    </main>
</div>
