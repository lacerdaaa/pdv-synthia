<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synthia.Terminal.App.ViewModels"
        xmlns:views="using:Synthia.Terminal.App.Views"
        xmlns:app="using:Synthia.Terminal.App"
        x:Class="Synthia.Terminal.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synthia · Caixa"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowState="Maximized"
        Background="#F7F5F0">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:OpenShiftViewModel"><views:OpenShiftView /></DataTemplate>
    <DataTemplate DataType="vm:SaleViewModel"><views:SaleView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1D1C1A" Padding="20,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="Synthia" FontWeight="Bold" FontSize="18" Foreground="White" />
          <TextBlock Text="{Binding StoreName}" FontSize="15" Foreground="#A29E95" VerticalAlignment="Center" />
          <Border Background="#2F6FDB" CornerRadius="5" Padding="8,2">
            <TextBlock Text="{Binding TerminalId}" Foreground="White" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding OperatorName}" Foreground="#ECEBE7" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
          <Ellipse Width="10" Height="10" Fill="{Binding SyncLevel, Converter={x:Static app:StateBrushConverter.Instance}}" />
          <TextBlock Text="{Binding SyncText}" Foreground="#ECEBE7" FontSize="14" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding Clock}" Foreground="#ECEBE7" FontSize="15" FontFamily="monospace" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="#FBF0DC" Padding="20,6" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Banner}" Foreground="#8A5300" FontWeight="SemiBold" />
    </Border>
    <ContentControl Content="{Binding Screen}" Margin="20" />
  </DockPanel>
</Window>
