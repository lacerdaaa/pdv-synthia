<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synthia.Terminal.App.ViewModels"
        xmlns:views="using:Synthia.Terminal.App.Views"
        xmlns:app="using:Synthia.Terminal.App"
        x:Class="Synthia.Terminal.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synthia · Caixa"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowState="Maximized"
        Background="{StaticResource PageBrush}"
        Icon="/Assets/logo-padrao.png">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:OpenShiftViewModel"><views:OpenShiftView /></DataTemplate>
    <DataTemplate DataType="vm:SaleViewModel"><views:SaleView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- Topo branco com a logo da loja; filete na cor de destaque embaixo. -->
    <Border DockPanel.Dock="Top" Background="White" Padding="20,8" BorderBrush="{StaticResource RedBrush}" BorderThickness="0,0,0,3">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Image Source="{Binding Logo, Source={x:Static app:StoreBrand.Current}}" Height="60" MaxWidth="220" />
          <Border Width="1" Height="36" Background="{StaticResource LineBrush}" />
          <Border Background="{StaticResource NavyBrush}" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
            <TextBlock Text="{Binding TerminalId}" Foreground="White" FontWeight="Bold" FontSize="16" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding OperatorName}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StoreName, Source={x:Static app:StoreBrand.Current}}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
          <Ellipse Width="10" Height="10" Fill="{Binding SyncLevel, Converter={x:Static app:StateBrushConverter.Instance}}" />
          <TextBlock Text="{Binding SyncText}" FontSize="14" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding Clock}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource NavyBrush}" FontFamily="monospace" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="#FBF0DC" Padding="20,6" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Banner}" Foreground="#8A5300" FontWeight="SemiBold" />
    </Border>
    <ContentControl Content="{Binding Screen}" Margin="20" />
  </DockPanel>
</Window>
